<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Categories</title>
</head>

<body>
    <header class="page-header">
        <p class="brand-name">ByteInventory</p>
        <h3 class="page-title">Categories</h3>
    </header>

    <main class="page-content">
        <section class="page-introduction">
            <p class="intro-text">Browse computer parts by category.</p>
        </section>

        <nav class="category-actions">
            <a class="add-category-link" href="/categories/new"> Add category </a>
        </nav>

        <section class="category-list">

            <% categories.forEach(function(category,index) { %>
                <div>
                    <a href="/categories/<%=category.id %>">
                        <%=category.name %>
                    </a>
                    <p>
                        <%=category.description %>
                    </p>
                    <p>
                        <%=totalItems[index] %> items
                    </p>
                </div>
                <% }); %>

        </section>
    </main>

    <a class="back-to-home-link" href="/">Return to Main Page</a>
</body>

</html>
