<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ByteInventory | PC Inventory</title>
  </head>
  <body>
    <header class="site-header">
      <p class="welcome-message">Welcome to</p>
      <h1 class="site-title">ByteInventory</h1>
    </header>
    <main class="main-content">
      <section class="introduction">
        <p class="introduction-text">
          A computer parts inventory for managing categories, products, prices,
          and stock quantities.
        </p>
      </section>

      <nav class="inventory-navigation">
        <a class="navigation-link" href="/categories"> Browse Categories </a>
        <a class="navigation-link" href="/items"> Browse All Items </a>
      </nav>

      <section class="inventory-overview">
        <h2 class="section-title">Inventory Overview</h2>

        <p class="section-description">
          Review the available categories and inspect every part currently
          stored in PostgreSQL.
        </p>
      </section>
    </main>

    <footer class="site-footer">
      <p>ByteInventory &copy; 2026</p>
    </footer>
  </body>
</html>
