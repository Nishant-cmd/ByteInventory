<article class="category-card">
  <h3 class="category-card__name">
    <a class="category-card__link" href="/categories/<%= category.name %>"
      ><%= category.name %></a
    >
  </h3>
  <p class="category-card__description"><%= category.description %></p>
  <p class="category-card__item-count"><%= category.totalItems %> items</p>
</article>
